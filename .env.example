# =========================================================================
# Delivery Control Tower — environment variables
# =========================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is in .gitignore.

# --- App --------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Delivery Control Tower"
NEXT_PUBLIC_APP_ENV="development"

# --- Supabase (to be enabled in the next phase) -----------------------
# Uncomment when you create your Supabase project and swap the in-memory
# data layer for real persistence.
#
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGci..."
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..."   # server-only, never expose in the browser

# --- Authentication (future) -----------------------------------------
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
